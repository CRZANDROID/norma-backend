// NORMA — modelo administrativo del piloto Arca
// Auth: JWT propio (passwordHash). Datos de negocio: Prisma/PostgreSQL (Supabase u otro).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ANALYST
  VIEWER
  CLIENT_USER
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum ImpactLevel {
  GREEN
  YELLOW
  ORANGE
  RED
}

enum FindingStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum SourceCategory {
  OFFICIAL
  MEDIA
  SOCIAL
}

enum SourcePlatform {
  WEB
  YOUTUBE
  X
  TIKTOK
  FACEBOOK
  INSTAGRAM
  OTHER
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String       @map("password_hash")
  name         String
  role         UserRole     @default(ANALYST)
  status       EntityStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  memberships ClientMembership[]
  documents   Document[]

  @@map("users")
}

model Client {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  email     String?
  phone     String?
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  memberships ClientMembership[]
  profiles    RegulatoryProfile[]
  findings    Finding[]
  documents   Document[]
  clientSources ClientSource[]
  fiscalData  ClientFiscalData?
  contacts    ClientContact[]

  @@map("clients")
}

/// Datos fiscales del cliente (1:1). Campos operativos del Client quedan aparte.
model ClientFiscalData {
  id            String   @id @default(cuid())
  clientId      String   @unique @map("client_id")
  legalName     String   @map("legal_name")
  rfc           String
  postalCode    String   @map("postal_code")
  /// CFDI use code (SAT catalog, e.g. G03)
  cfdi          String
  /// Tax regime code (SAT catalog, e.g. 601)
  taxRegime     String   @map("tax_regime")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_fiscal_data")
}

/// Contactos directos del cliente (soporte / detalle operativo).
model ClientContact {
  id        String       @id @default(cuid())
  clientId  String       @map("client_id")
  name      String
  phone     String
  email     String?
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
  @@map("client_contacts")
}

model ClientMembership {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  clientId  String       @map("client_id")
  role      UserRole     @default(ANALYST)
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([clientId])
  @@map("client_memberships")
}

model RegulatoryProfile {
  id          String       @id @default(cuid())
  clientId    String       @map("client_id")
  name        String
  description String?
  keywords    String[]     @default([])
  categories  String[]     @default([])
  products    Json?
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("regulatory_profiles")
}

model Source {
  id            String         @id @default(cuid())
  name          String
  code          String         @unique
  category      SourceCategory
  platform      SourcePlatform
  url           String?
  frequency     String?
  /// Paths de secciones a revisar, p.ej. [["Comunicados","Normatividad","Alertas sanitarias"]]
  sections      Json           @default("[]")
  keywordsGuide String[]       @default([]) @map("keywords_guide")
  status        EntityStatus   @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  findings      Finding[]
  clientSources ClientSource[]

  @@index([status])
  @@index([category])
  @@index([platform])
  @@map("sources")
}

/// Relación N:N cliente ↔ fuente (no altera tablas clients/sources).
model ClientSource {
  id        String   @id @default(cuid())
  clientId  String   @map("client_id")
  sourceId  String   @map("source_id")
  createdAt DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([clientId, sourceId])
  @@index([sourceId])
  @@map("client_sources")
}

model Finding {
  id          String        @id @default(cuid())
  title       String
  description String?
  impact      ImpactLevel   @default(YELLOW)
  status      FindingStatus @default(OPEN)
  clientId    String?       @map("client_id")
  sourceId    String?       @map("source_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  source Source? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([sourceId])
  @@index([status])
  @@index([impact])
  @@map("findings")
}

/// Metadatos de archivos en Supabase Storage (infra para documentos futuros).
/// El binario vive en el bucket; esta tabla guarda la referencia.
model Document {
  id           String       @id @default(cuid())
  clientId     String?      @map("client_id")
  uploadedById String?      @map("uploaded_by_id")
  bucket       String
  path         String
  filename     String
  mimeType     String?      @map("mime_type")
  sizeBytes    Int?         @map("size_bytes")
  status       EntityStatus @default(ACTIVE)
  metadata     Json?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  client     Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  uploadedBy User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([bucket, path])
  @@index([clientId])
  @@index([uploadedById])
  @@index([status])
  @@map("documents")
}
