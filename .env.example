# Server
NODE_ENV=development
PORT=3000

# Database (Supabase → Project Settings → Database → Connect)
# If direct db.* fails with P1001 (IPv6-only), use Session pooler (IPv4):
#   postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# URL-encode special chars in the password (& → %26, % → %25, @ → %40, etc.)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# CORS — frontend origin
CORS_ORIGIN=http://localhost:5173

# Own JWT auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# Seed admin (prisma/seed.ts)
AUTH_SEED_EMAIL=admin@norma.local
AUTH_SEED_PASSWORD=ChangeMe123!
# true (default) = Arca + fuentes. false = solo ADMIN.
# En capacitación dejar false: un seed completo recrea el catálogo.
# SEED_CATALOG=false

# Sentry (opcional en local; recomendado en staging/prod)
# Si está vacío, Sentry queda deshabilitado.
SENTRY_DSN=

# OpenAI — asistente de catálogo (POST /ai/ask). Vacío → 503 en /ai/ask.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Redis + BullMQ. Local canónico = docker compose (pisa a redis://redis:6379).
# Este valor solo aplica si corres Nest en el host sin Compose.
REDIS_URL=redis://127.0.0.1:6379
# Compose pisa: api JOBS_WORKER=false JOBS_SCHEDULER=false; worker ambos true.
# JOBS_WORKER=false
# En el host (sin Compose) el cron está OFF salvo JOBS_SCHEDULER=true.
JOBS_SCHEDULER=false
# Sitios a la vez (cola source.crawl). Default 2. No es el tope del catálogo.
# CRAWL_CONCURRENCY=2
# extract + normalize. Default 2. No subirlo a ciegas.
# JOBS_CONCURRENCY=2
# Solo classify (si OpenAI 429). Default = JOBS_CONCURRENCY.
# CLASSIFY_CONCURRENCY=1
# Lock BullMQ del crawl (ms). Default 900000 (15 min).
# CRAWL_LOCK_MS=900000
# Lock extract / normalize / classify (ms). Default 600000 (10 min).
# DOCUMENT_LOCK_MS=600000
# Timeout de unpdf en worker thread (ms). Default 180000. Ese PDF falla; el resto del worker sigue.
# EXTRACT_PDF_TIMEOUT_MS=180000
# Tope del body HTTP del crawl (bytes). Default 10000000. Aguascalientes home ~7 MB.
# CRAWL_MAX_BYTES=10000000
# Páginas del mismo sitio por job (no solo la portada). Default 40, tope 80.
# Laboratorio de rendimiento: 10. Default 80 cuando pasen las fases 1–3.
# CRAWL_MAX_PAGES=10

# Supabase Storage (archivos). No es la auth de la app.
# Project Settings → API → Project URL + service_role (secret)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
