# Server
NODE_ENV=development
PORT=3000

# Database (Supabase → Project Settings → Database → Connection string → URI)
# Prefer direct/session (5432) for Prisma Migrate; pooler (6543) can be used at runtime.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# CORS — frontend origin
CORS_ORIGIN=http://localhost:5173

# Supabase Auth (Settings → API)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
# JWT Secret used by NestJS to verify access tokens (Settings → API → JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
