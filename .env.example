# Server
NODE_ENV=development
PORT=3000

# Database (Supabase → Project Settings → Database → Connect)
# Session pooler (IPv4, puerto 5432) para `prisma migrate`. El runtime de Nest
# lo reescribe a Transaction (6543) + pgbouncer: el Session admite ~15 clientes
# globales y Render + Docker lo saturan (EMAXCONNSESSION).
#   postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# URL-encode special chars in the password (& → %26, % → %25, @ → %40, etc.)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# Tope de Prisma por proceso (Compose pisa a 2). Default 3.
# DATABASE_CONNECTION_LIMIT=3

# CORS — frontend origin
CORS_ORIGIN=http://localhost:5173

# Own JWT auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# Seed admin (prisma/seed.ts)
AUTH_SEED_EMAIL=admin@norma.local
AUTH_SEED_PASSWORD=ChangeMe123!
# true (default) = Arca + fuentes. false = solo ADMIN.
# En capacitación dejar false: un seed completo recrea el catálogo.
# SEED_CATALOG=false

# Sentry (opcional en local; recomendado en staging/prod)
# Si está vacío, Sentry queda deshabilitado.
SENTRY_DSN=

# OpenAI — asistente de catálogo (POST /ai/ask). Vacío → 503 en /ai/ask.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Redis + BullMQ. Local canónico = docker compose (pisa a redis://redis:6379).
# Este valor solo aplica si corres Nest en el host sin Compose.
REDIS_URL=redis://127.0.0.1:6379
# Compose pisa: api JOBS_WORKER=false JOBS_SCHEDULER=false; worker ambos true.
# JOBS_WORKER=false
# En el host (sin Compose) el cron está OFF salvo JOBS_SCHEDULER=true.
JOBS_SCHEDULER=false
# Sitios a la vez (cola source.crawl). Default 2. No es el tope del catálogo.
# CRAWL_CONCURRENCY=2
# extract + normalize. Default 2. No subirlo a ciegas.
# JOBS_CONCURRENCY=2
# Solo classify (si OpenAI 429). Default = JOBS_CONCURRENCY.
# CLASSIFY_CONCURRENCY=1
# Lock BullMQ del crawl (ms). Default 5400000 (90 min).
# CRAWL_LOCK_MS=5400000
# Lock extract / normalize / classify (ms). Default 900000 (15 min).
# DOCUMENT_LOCK_MS=900000
# Timeout de unpdf en worker thread (ms). Default 300000. Ese PDF falla; el resto del worker sigue.
# EXTRACT_PDF_TIMEOUT_MS=300000
# Tope del body HTTP del crawl (bytes). Default 25000000.
# CRAWL_MAX_BYTES=25000000
# Páginas legislativas del mismo sitio por job. Default 200 (tope absoluto 2000).
# CRAWL_MAX_PAGES=200
# Clics desde la portada. Default 4 (tope absoluto 8).
# CRAWL_MAX_DEPTH=4
# Año mínimo de publicación (URL, ddMMyyyy, dateline del texto). Default 2026. Sin fecha sí entra.
# CRAWL_MIN_YEAR=2026

# Supabase Storage (archivos). No es la auth de la app.
# Project Settings → API → Project URL + service_role (secret)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
