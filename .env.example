# Server
NODE_ENV=development
PORT=3000

# Database (Supabase → Project Settings → Database → Connect)
# If direct db.* fails with P1001 (IPv6-only), use Session pooler (IPv4):
#   postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# URL-encode special chars in the password (& → %26, % → %25, @ → %40, etc.)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# CORS — frontend origin
CORS_ORIGIN=http://localhost:5173

# Own JWT auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# Seed admin (prisma/seed.ts)
AUTH_SEED_EMAIL=admin@norma.local
AUTH_SEED_PASSWORD=ChangeMe123!

# Sentry (opcional en local; recomendado en staging/prod)
# Si está vacío, Sentry queda deshabilitado.
SENTRY_DSN=

# Supabase Storage (archivos). No es la auth de la app.
# Project Settings → API → Project URL + service_role (secret)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
